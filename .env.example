# =============================================================================
# Ravi — environment template
# -----------------------------------------------------------------------------
# On first run, `ravi init` / `ravi start` copies this file to `.env` and fills
# secrets that are still placeholders. Keep this file complete: every key that
# may appear in `.env` should be listed here with a safe template value.
# NEVER commit a real `.env` file.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_USER=ravi
POSTGRES_PASSWORD=change_me_to_a_strong_password

# -----------------------------------------------------------------------------
# LiteLLM master key (API auth for clients + Admin UI password fallback)
# Auto-generated on first `ravi init` when still a placeholder.
# -----------------------------------------------------------------------------
LITELLM_MASTER_KEY=sk-ravi-change-me-to-a-secure-key

# Admin UI login (UI_PASSWORD defaults to the master key when empty)
UI_USERNAME=admin
UI_PASSWORD=

# -----------------------------------------------------------------------------
# Host path for local model weights (GGUF, ONNX, SD checkpoints)
# Shared into containers at /models (read-only).
#   Linux/macOS:  /home/you/ravi-models   or  ./models
#   Windows:      D:/ravi-models          (forward slashes preferred)
# Use `ravi share` (admin/sudo) to help Docker access this path.
# -----------------------------------------------------------------------------
RAVI_MODELS_DIR=./models

# -----------------------------------------------------------------------------
# Runtime — backend, language, context
# -----------------------------------------------------------------------------
# llama = llama.cpp (default) | ollama = optional Ollama profile
RAVI_LLM_BACKEND=llama
# on | off — unload LLM containers when off to free RAM
RAVI_LLM=on
# Chat UI language code (en, fa, de, zh, ...)
RAVI_LANG=en
# Token context window (auto-filled from hardware presets if left default)
RAVI_CONTEXT=8192
RAVI_THREADS=4
RAVI_DEFAULT_MODEL=qwen3-4b-instruct-2507-q4km
RAVI_WELCOME_MESSAGE=Hello! I am Ravi, your local AI gateway. Ask me anything.

# -----------------------------------------------------------------------------
# Media toggles (local + cloud policy flags)
# -----------------------------------------------------------------------------
RAVI_VOICE=off
RAVI_IMAGE=off
RAVI_VIDEO=off
RAVI_VOICE_MODEL=kokoro-82m-onnx-int8
RAVI_IMAGE_MODEL=sd15-q4_0
RAVI_VIDEO_MODEL=wan-video-placeholder
RAVI_LOCAL_MODEL=
RAVI_LOCAL_GGUF=

# Optional Ollama endpoint when RAVI_LLM_BACKEND=ollama
OLLAMA_API_BASE=http://ollama:11434
# OLLAMA_HOST=http://127.0.0.1:11434

# -----------------------------------------------------------------------------
# Cloudflare Workers AI
# -----------------------------------------------------------------------------
CLOUDFLARE_AI_BASE_URL=https://api.cloudflare.com/client/v4/accounts/YOUR_ACCOUNT_ID/ai/v1
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

# -----------------------------------------------------------------------------
# Google Gemini — multi-key pool (leave unused keys empty)
# -----------------------------------------------------------------------------
GEMINI_API_KEY_1=your_gemini_api_key_1
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_API_KEY_6=
GEMINI_API_KEY_7=
GEMINI_API_KEY_8=
GEMINI_API_KEY_9=
GEMINI_API_KEY_10=
GEMINI_API_KEY_11=
GEMINI_API_KEY_12=
GEMINI_API_KEY_13=
GEMINI_API_KEY_14=
GEMINI_API_KEY_15=
GEMINI_API_KEY_16=
GEMINI_API_KEY_17=
GEMINI_API_KEY_18=
# GEMINI_API_KEY=

# -----------------------------------------------------------------------------
# Other cloud providers (optional)
# -----------------------------------------------------------------------------
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# Proxy URL used by the CLI when talking to the local gateway
# -----------------------------------------------------------------------------
# RAVI_PROXY_URL=http://127.0.0.1:4000


# -----------------------------------------------------------------------------
# Smart logs (optional LLM rewrite of event/chat logs)
# Programmatic logs always store without LLM. Set on to enable Celery worker:
#   docker compose --profile smartlog up -d
# -----------------------------------------------------------------------------
# Set to on to enable LLM log summaries at startup (starts worker profile)
RAVI_SMART_LOG=off
POSTGRES_DB=ravi
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
REDIS_URL=redis://127.0.0.1:6379/0
# DATABASE_URL=postgresql://ravi:password@127.0.0.1:5432/ravi

# off until the full stack is healthy; set automatically by ravi start → on
RAVI_STATUS=off


# -----------------------------------------------------------------------------
# Celery Flower (worker / queue monitor) — http://127.0.0.1:5555
# -----------------------------------------------------------------------------
FLOWER_PORT=5555
# FLOWER_BASIC_AUTH=admin:change_me


# -----------------------------------------------------------------------------
# Sentry / error reporting (does not replace Ravi structured logs)
# on  = capture errors from CLI, workers, LLM paths
# off = no capture; errors UI container not started
# Web UI is started on demand by: ravi errors show
# -----------------------------------------------------------------------------
RAVI_SENTRY=on
SENTRY_DSN=
# Local GlitchTip UI (Sentry-compatible). Opened by `ravi errors show`.
SENTRY_WEB_URL=http://127.0.0.1:8000
SENTRY_WEB_PORT=8000
SENTRY_SECRET_KEY=change-me-ravi-errors-secret-key-32chars
SENTRY_TRACES_SAMPLE_RATE=0.0


# -----------------------------------------------------------------------------
# Resource profile: small | medium | large | extra | custom
# -----------------------------------------------------------------------------
RAVI_PROFILE=medium


# -----------------------------------------------------------------------------
# State: local | cloud | both
# local  = local models / profiles
# cloud  = cloud APIs only (local LLM unloaded)
# both   = local planner → cloud responder
# -----------------------------------------------------------------------------
RAVI_STATE=local
RAVI_CLOUD_MODEL=


# -----------------------------------------------------------------------------
# Laya decision model (Orchestrator). Medium+ default: English, lower RAM.
# large/extra use multilingual. small keeps this off.
# -----------------------------------------------------------------------------
RAVI_LAYA=on
# Weights path: $RAVI_MODELS_DIR/laya/{english|multilingual} — no re-download if present
RAVI_LAYA_VARIANT=english
RAVI_LAYA_MODEL=laya-english
LAYA_API_BASE=http://127.0.0.1:8090
LAYA_PORT=8090
LAYA_DEVICE=cpu


# -----------------------------------------------------------------------------
# Command confirmation sensitivity (with Laya when RAVI_LAYA=on)
# low    = confirm if risk score >= 0.66
# medium = >= 0.33   (default)
# high   = >= 0.18   (ask more often)
# -----------------------------------------------------------------------------
RAVI_CONFIRMS=medium

# Custom percent when RAVI_CONFIRMS=custom (0-100). Example: 5 → confirm above 5%
RAVI_CONFIRMS_RISKS=
